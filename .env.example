# Copy to .env. Anything starting with VITE_ is built into the frontend bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the browser finds server/index.ts. Leave empty for local dev
# (http://localhost:3001). An https site needs an https URL here.
VITE_SERVER_URL=

# Server only. server/index.ts reads it and proxies the chat's OpenRouter
# calls, so it never reaches the browser. Don't add a VITE_ prefix.
OPENROUTER_API_KEY=
