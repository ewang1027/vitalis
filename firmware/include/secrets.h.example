// Copy this file to secrets.h (same folder) and fill in your values.
// secrets.h is gitignored.
#pragma once

// 2.4 GHz network only, the ESP32 can't join 5 GHz.
#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// LAN address of the machine running `npm run dev` (the Express server on port 3001).
#define SERVER_URL "http://192.168.1.100:3001/api/hardware"

// The room this node is in. Must match that room's id or room_number in the
// Supabase rooms table. Each room's 3D view only shows its own node.
#define ROOM_ID "room-101"

// Optional. Defaults to the board's WiFi MAC address.
// #define DEVICE_ID "room-101-node"
